{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CohortBundleManifest",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "synthetic_data",
    "study_ids",
    "files",
    "licence_and_access"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "synthetic_data": { "type": "boolean" },
    "study_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "licence_and_access": { "type": "string", "minLength": 1 },
    "files": {
      "type": "object",
      "required": ["publications", "repository_records", "variable_dictionary"],
      "additionalProperties": false,
      "properties": {
        "publications": { "$ref": "#/$defs/file" },
        "repository_records": { "$ref": "#/$defs/file" },
        "variable_dictionary": { "$ref": "#/$defs/file" }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256", "row_count"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "row_count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
