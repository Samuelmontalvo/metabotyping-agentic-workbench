{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "nonnegativeInteger": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_metadata": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": { "const": "AN006016" },
        "analysis_summary": { "const": "Reversed phase UNSPECIFIED ION MODE" },
        "analysis_type": { "const": "MS" },
        "chromatography_type": { "const": "Reversed phase" },
        "ms_instrument_name": { "const": "Thermo Q Exactive HF hybrid Orbitrap" },
        "ms_instrument_type": { "const": "Orbitrap" },
        "study_id": { "const": "ST003662" },
        "units": { "const": "umol/L whole blood" }
      },
      "required": [
        "study_id",
        "analysis_id",
        "analysis_summary",
        "analysis_type",
        "chromatography_type",
        "ms_instrument_type",
        "ms_instrument_name",
        "units"
      ],
      "type": "object"
    },
    "acceptance_checks": {
      "additionalProperties": false,
      "properties": {
        "exact_sign_test_p_value_within_threshold": {
          "type": "boolean"
        },
        "identity_review_gate_preserved": {
          "const": true
        },
        "matrix_mismatch_caveat_preserved": {
          "const": true
        },
        "mean_paired_log2_change_above_threshold": {
          "type": "boolean"
        },
        "minimum_complete_positive_pairs_met": {
          "type": "boolean"
        },
        "responder_proportion_above_threshold": {
          "type": "boolean"
        }
      },
      "required": [
        "minimum_complete_positive_pairs_met",
        "mean_paired_log2_change_above_threshold",
        "responder_proportion_above_threshold",
        "exact_sign_test_p_value_within_threshold",
        "identity_review_gate_preserved",
        "matrix_mismatch_caveat_preserved"
      ],
      "type": "object"
    },
    "acceptance_rules": {
      "additionalProperties": false,
      "properties": {
        "cached_log2fc_absolute_tolerance": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "exact_sign_test_alternative": {
          "const": "two_sided"
        },
        "maximum_exact_sign_test_p_value": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "mean_paired_log2_change_operator": {
          "const": "greater_than"
        },
        "mean_paired_log2_change_threshold": {
          "const": 0
        },
        "minimum_complete_positive_pairs": {
          "minimum": 1,
          "type": "integer"
        },
        "minimum_responder_proportion": {
          "maximum": 1,
          "minimum": 0.5,
          "type": "number"
        },
        "responder_proportion_operator": {
          "const": "greater_than"
        }
      },
      "required": [
        "minimum_complete_positive_pairs",
        "mean_paired_log2_change_operator",
        "mean_paired_log2_change_threshold",
        "responder_proportion_operator",
        "minimum_responder_proportion",
        "exact_sign_test_alternative",
        "maximum_exact_sign_test_p_value",
        "cached_log2fc_absolute_tolerance"
      ],
      "type": "object"
    },
    "cached_effect_crosscheck": {
      "additionalProperties": false,
      "properties": {
        "absolute_difference": {
          "minimum": 0,
          "type": "number"
        },
        "absolute_tolerance": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "cached_log2fc": {
          "type": "number"
        },
        "cached_p_value": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "cached_p_value_status": {
          "const": "not_independently_recomputed"
        },
        "cached_fdr": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "cached_fdr_status": {
          "const": "not_independently_recomputed"
        },
        "cached_neg_log10_p": {
          "minimum": 0,
          "type": "number"
        },
        "neg_log10_p_absolute_difference": {
          "minimum": 0,
          "type": ["number", "null"]
        },
        "neg_log10_p_internal_consistency": {
          "type": ["boolean", "null"]
        },
        "recomputed_mean_paired_log2_change": {
          "type": "number"
        },
        "stratum": {
          "const": "all"
        },
        "study_id": {
          "const": "ST003662"
        },
        "within_tolerance": {
          "const": true
        }
      },
      "required": [
        "study_id",
        "stratum",
        "cached_log2fc",
        "cached_p_value",
        "cached_p_value_status",
        "cached_fdr",
        "cached_fdr_status",
        "cached_neg_log10_p",
        "neg_log10_p_internal_consistency",
        "neg_log10_p_absolute_difference",
        "recomputed_mean_paired_log2_change",
        "absolute_difference",
        "absolute_tolerance",
        "within_tolerance"
      ],
      "type": "object"
    },
    "case_id": {
      "minLength": 1,
      "type": "string"
    },
    "cohort_independence_status": {
      "const": "not_established"
    },
    "dataset_selection_status": {
      "const": "post_hoc_exploratory"
    },
    "exact_paper_dataset": {
      "const": false
    },
    "interpretation": {
      "minLength": 1,
      "type": "string"
    },
    "outcome": {
      "enum": [
        "supports_directional_claim_requires_identity_review",
        "does_not_support",
        "blocked"
      ],
      "type": "string"
    },
    "paired_statistics": {
      "additionalProperties": false,
      "properties": {
        "complete_positive_pairs": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "exact_sign_test": {
          "additionalProperties": false,
          "properties": {
            "alternative": {
              "const": "two_sided"
            },
            "exact_fraction": {
              "type": [
                "string",
                "null"
              ]
            },
            "n_non_tied": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "negative_count": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "p_value": {
              "maximum": 1,
              "minimum": 0,
              "type": [
                "number",
                "null"
              ]
            },
            "positive_count": {
              "$ref": "#/$defs/nonnegativeInteger"
            }
          },
          "required": [
            "alternative",
            "positive_count",
            "negative_count",
            "n_non_tied",
            "p_value",
            "exact_fraction"
          ],
          "type": "object"
        },
        "excluded_incomplete_or_nonpositive_pairs": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "geometric_mean_fold_change": {
          "$ref": "#/$defs/nullableNumber"
        },
        "geometric_mean_fold_change_status": {
          "enum": [
            "computed_finite",
            "unrepresentable_overflow",
            "unrepresentable_underflow",
            "not_computed_no_complete_positive_pairs"
          ]
        },
        "mean_paired_log2_change": {
          "$ref": "#/$defs/nullableNumber"
        },
        "nonresponder_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "responder_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "responder_proportion": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "tie_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "total_queried_rows": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      },
      "required": [
        "total_queried_rows",
        "complete_positive_pairs",
        "excluded_incomplete_or_nonpositive_pairs",
        "mean_paired_log2_change",
        "geometric_mean_fold_change",
        "geometric_mean_fold_change_status",
        "responder_count",
        "nonresponder_count",
        "responder_proportion",
        "tie_count",
        "exact_sign_test"
      ],
      "type": "object"
    },
    "paper_claim": {
      "additionalProperties": false,
      "properties": {
        "analyte_evidence_verified_in_cached_record": {
          "const": true
        },
        "direction": {
          "const": "Lac-Phe is higher after exercise"
        },
        "doi": {
          "const": "10.1038/s41586-022-04828-5"
        },
        "doi_verified_in_cached_record": {
          "const": true
        },
        "title": {
          "const": "An exercise-inducible metabolite that suppresses feeding and obesity"
        }
      },
      "required": [
        "doi",
        "title",
        "direction",
        "doi_verified_in_cached_record",
        "analyte_evidence_verified_in_cached_record"
      ],
      "type": "object"
    },
    "replication_context": {
      "additionalProperties": false,
      "properties": {
        "cohort_independence_status": {
          "const": "not_established"
        },
        "contrast": {
          "const": "post-exercise vs pre-exercise (Collectionpoint After vs Before)"
        },
        "dataset_selection_caveat": {
          "minLength": 1,
          "type": "string"
        },
        "dataset_selection_status": {
          "const": "post_hoc_exploratory"
        },
        "harmonization_eligibility": {
          "const": "requires_assay_identity_review"
        },
        "identity_status": {
          "const": "requires_human_review"
        },
        "matrix_mismatch_caveat": {
          "minLength": 1,
          "type": "string"
        },
        "matrix_relationship_to_paper": {
          "const": "mismatch"
        },
        "orientation": {
          "const": "positive log2fc = higher post-exercise"
        },
        "post_collectionpoint": {
          "const": "After"
        },
        "pre_collectionpoint": {
          "const": "Before"
        },
        "refmet_id": {
          "const": "RM0131640"
        },
        "refmet_name": {
          "const": "N-Lactoyl phenylalanine"
        },
        "refmet_release_status": {
          "const": "not_recorded_in_cached_annotation_file"
        },
        "sample_matrix": {
          "const": "whole blood"
        },
        "source_metabolite": {
          "const": "Lactoyl Phenylalanine"
        },
        "species": {
          "const": "Homo sapiens"
        },
        "stratum": {
          "const": "all"
        },
        "study_id": {
          "const": "ST003662"
        },
        "study_title": {
          "minLength": 1,
          "type": "string"
        },
        "timing_caveat": {
          "minLength": 1,
          "type": "string"
        },
        "timing_status": {
          "const": "before_after_labels_verified_protocol_timing_not_reported"
        },
        "unit": {
          "const": "umol/L whole blood (study-reported)"
        }
      },
      "required": [
        "cohort_independence_status",
        "dataset_selection_status",
        "dataset_selection_caveat",
        "study_id",
        "study_title",
        "species",
        "source_metabolite",
        "refmet_name",
        "refmet_id",
        "refmet_release_status",
        "stratum",
        "sample_matrix",
        "unit",
        "pre_collectionpoint",
        "post_collectionpoint",
        "contrast",
        "orientation",
        "identity_status",
        "harmonization_eligibility",
        "matrix_relationship_to_paper",
        "matrix_mismatch_caveat",
        "timing_status",
        "timing_caveat"
      ],
      "type": "object"
    },
    "result_version": {
      "const": "1.0.0"
    },
    "source_provenance": {
      "additionalProperties": false,
      "properties": {
        "license": { "const": "CC BY 4.0" },
        "match_basis": { "const": "normalized name containment across source name columns" },
        "study_link": { "const": "https://www.metabolomicsworkbench.org/data/DRCCMetadata.php?StudyID=ST003662" }
      },
      "required": ["match_basis", "license", "study_link"],
      "type": "object"
    },
    "scope": {
      "const": "post_hoc_external_dataset_directional_corroboration"
    }
  },
  "required": [
    "result_version",
    "case_id",
    "scope",
    "exact_paper_dataset",
    "cohort_independence_status",
    "dataset_selection_status",
    "outcome",
    "paper_claim",
    "replication_context",
    "analysis_metadata",
    "source_provenance",
    "paired_statistics",
    "cached_effect_crosscheck",
    "acceptance_rules",
    "acceptance_checks",
    "interpretation"
  ],
  "title": "BiomarkerReproductionResult",
  "type": "object"
}
